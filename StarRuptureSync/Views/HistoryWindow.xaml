<Window x:Class="StarRuptureSync.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="clr-namespace:StarRuptureSync.Models"
        Title="Repository history"
        Height="560" Width="640"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Commit history (newest first)" FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10" />

        <Border Grid.Row="1" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="6">
            <ListView ItemsSource="{Binding}" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:CommitInfo}">
                        <StackPanel>
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Text}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextDim}"
                                       FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" MinWidth="100"
                Margin="0,14,0,0" IsCancel="True" Click="OnCloseClick" />
    </Grid>
</Window>
