<Window x:Class="StarRuptureSync.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StarRuptureSync.ViewModels"
        xmlns:model="clr-namespace:StarRuptureSync.Models"
        Title="StarRupture Save Sync"
        Height="720" Width="1080"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="150" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontWeight="Bold" FontSize="15">
                            <Run Text="User: " /><Run Text="{Binding Username, Mode=OneWay}" />
                            <Run Text="   •   Syncing origin/main" />
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,3,0,0"
                                   Text="{Binding RepoUrl, Mode=OneWay}" />
                        <TextBlock Foreground="{StaticResource TextDim}" FontSize="11"
                                   Text="{Binding SaveGamesPath, Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="⟳  Refresh (fetch + reset)"
                            Style="{StaticResource AccentButton}"
                            VerticalAlignment="Center"
                            Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>

            <!-- Game running status -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="11" Height="11" VerticalAlignment="Center"
                             Fill="{Binding GameStatusBrush}" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GameStatusText}" FontWeight="SemiBold" />
                        <TextBlock Text="Auto-checked every 30 seconds. Sync is disabled while the game is running."
                                   Foreground="{StaticResource TextDim}" FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="⟳  Check now"
                            VerticalAlignment="Center"
                            Command="{Binding CheckGameCommand}" />
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sessions list -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Sessions" FontWeight="SemiBold"
                                   Margin="8,6,8,8" />
                        <ListBox ItemsSource="{Binding Sessions}"
                                 SelectedItem="{Binding SelectedSession}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="b" CornerRadius="6" Padding="10,8"
                                                        Background="{StaticResource PanelAlt}"
                                                        BorderBrush="{StaticResource Stroke}"
                                                        BorderThickness="1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="b" Property="BorderBrush"
                                                                Value="{StaticResource Accent}" />
                                                        <Setter TargetName="b" Property="Background"
                                                                Value="#2E3550" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SessionRowViewModel}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SessionName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StateText}" FontSize="11"
                                                   Foreground="{Binding StateBrush}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding LocalCopyText}" FontSize="10"
                                                   Foreground="{StaticResource TextDim}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Detail -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding DetailHeadline}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="{Binding DetailSubtext}" Foreground="{StaticResource TextDim}"
                                       FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>

                        <Border DockPanel.Dock="Top" Margin="0,12,0,0" Padding="12"
                                Background="{StaticResource PanelAlt}"
                                BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="6"
                                Visibility="{Binding InstructionsVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding InstructionsText}" />
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="⬇  Download (repo → Steam)"
                                    Command="{Binding DownloadCommand}" MinWidth="200" />
                            <Button Content="⬆  Upload (Steam → repo)"
                                    Style="{StaticResource AccentButton}"
                                    Command="{Binding UploadCommand}" MinWidth="200" Margin="10,0,0,0" />
                        </StackPanel>

                        <Border Margin="0,12,0,0" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="6">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Background="{StaticResource PanelAlt}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Save file" FontWeight="SemiBold" Margin="10,6" />
                                    <TextBlock Grid.Column="1" Text="Status" FontWeight="SemiBold" Margin="6,6" />
                                    <TextBlock Grid.Column="2" Text="Local hash" FontWeight="SemiBold" Margin="6,6" />
                                    <TextBlock Grid.Column="3" Text="Repo hash" FontWeight="SemiBold" Margin="6,6" />
                                </Grid>
                                <ListView ItemsSource="{Binding SelectedFiles}" BorderThickness="0"
                                          Background="Transparent"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="{x:Type model:FileComparison}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding FileName}" Margin="4,3" />
                                                <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="2,3" />
                                                <TextBlock Grid.Column="2" Text="{Binding LocalHash}" Margin="2,3"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextDim}" />
                                                <TextBlock Grid.Column="3" Text="{Binding RepoHash}" Margin="2,3"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextDim}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Log -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Activity" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11"
                             TextWrapping="NoWrap" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Busy overlay -->
        <Border Background="#B0000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="240" Height="6" />
                <TextBlock Text="{Binding BusyText}" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
