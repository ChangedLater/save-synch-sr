<Window x:Class="StarRuptureSync.Views.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="clr-namespace:StarRuptureSync.Models"
        Title="Session details"
        Height="520" Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding SessionName}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="{Binding Headline}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding FileSummary}" Foreground="{StaticResource Text}" Margin="0,2,0,0" />
            <TextBlock Text="{Binding RemoteChangeSummary}" Foreground="{StaticResource Text}"
                       FontSize="11" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Background="{StaticResource PanelAlt}"
                BorderBrush="{StaticResource Stroke}" BorderThickness="1,1,1,0"
                CornerRadius="6,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Save file" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="10,7" />
                <TextBlock Grid.Column="1" Text="Status" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="6,7" />
                <TextBlock Grid.Column="2" Text="Local edited" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="6,7" />
                <TextBlock Grid.Column="3" Text="Remote edited" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="6,7" />
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                CornerRadius="0,0,6,6">
            <ListView ItemsSource="{Binding Files}" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:FileComparison}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FileName}" Margin="4,4"
                                       Foreground="{StaticResource Text}" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="2,4"
                                       Foreground="{StaticResource Text}" />
                            <TextBlock Grid.Column="2" Text="{Binding LocalEditedText}" Margin="2,4"
                                       Foreground="{StaticResource Text}" />
                            <TextBlock Grid.Column="3" Text="{Binding RepoEditedText}" Margin="2,4"
                                       Foreground="{StaticResource Text}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Button Grid.Row="3" Content="Close" HorizontalAlignment="Right" MinWidth="100"
                Margin="0,14,0,0" IsCancel="True" Click="OnCloseClick" />
    </Grid>
</Window>
