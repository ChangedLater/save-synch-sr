<Window x:Class="StarRuptureSync.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:StarRuptureSync.Services"
        Title="StarRupture Save Sync — Sign in"
        Height="620" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="StarRupture Save Sync" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Share one save file across your group using a git repository."
                       Foreground="{StaticResource TextDim}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <Label Content="Username (recorded as the commit author)" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <Label Content="Git repository URL (HTTPS) — synced on the main branch" Margin="0,12,0,0" />
                <TextBox Text="{Binding RepoUrl, UpdateSourceTrigger=PropertyChanged}" />

                <Label Content="Git personal access token" Margin="0,12,0,0" />
                <PasswordBox x:Name="TokenBox" />
                <TextBlock Text="A stored token is already saved — leave blank to keep it."
                           Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding HasStoredKey, Converter={StaticResource BoolToVis}}" />

                <Label Content="StarRupture SaveGames folder" Margin="0,12,0,0" />
                <TextBox Text="{Binding SaveGamesPath, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Auto-detect" Command="{Binding DetectLocationCommand}" />
                    <Button Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding LocationCandidates}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:SaveLocationCandidate}">
                            <Button HorizontalContentAlignment="Left" Margin="0,3,0,0"
                                    Command="{Binding DataContext.UseCandidateCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Path}" />
                                    <TextBlock Text="{Binding Source}" FontSize="11"
                                               Foreground="{StaticResource TextDim}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Warn}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Continue" Style="{StaticResource AccentButton}"
                    Command="{Binding ContinueCommand}" MinWidth="120" />
        </StackPanel>
    </Grid>
</Window>
